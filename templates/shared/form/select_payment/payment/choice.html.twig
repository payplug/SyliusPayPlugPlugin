{% set form = hookable_metadata.context.form %}

<div
    {{ stimulus_controller('@payplug/sylius-payplug-plugin/checkout-select-payment') }}
    class="mb-5"
>
    {{ form_errors(form.method) }}

    {% for key, choice_form in form.method %}
        {% set method = form.method.vars.choices[key].data %}
        {% hook ['choice.' ~ method.gatewayConfig.factoryName, 'choice'] with {'parent_form': form, 'form': choice_form, 'method': method} %}
    {% else %}
        {% hook 'choice#unavailable' %}
    {% endfor %}
</div>
