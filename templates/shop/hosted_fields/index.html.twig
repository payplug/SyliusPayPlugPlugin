<script type="text/javascript" src="{{ payplug_hosted_fields_sdk_url()|e('html_attr') }}"></script>
{% set cardHolderMinLength = constant('PayPlug\\SyliusPayPlugPlugin\\PaymentProcessing\\HostedFieldsCaptureData::CARD_HOLDER_NAME_MIN_LENGTH') %}
{% set cardHolderMaxLength = constant('PayPlug\\SyliusPayPlugPlugin\\PaymentProcessing\\HostedFieldsCaptureData::CARD_HOLDER_NAME_MAX_LENGTH') %}
<script type="text/javascript">
  /* <![CDATA[ */
  var payplug_hosted_fields_params = {
    companyId: '{{ payplug_hosted_fields_company_id(paymentMethod)|e('js') }}',
    payment_method_code: '{{ paymentMethod.code|e('js') }}',
    {# Emitted as a real JS boolean, unlike integrated/index.html.twig's quoted interpolation of
       the same flag — that one only happens to work because Twig renders false as an empty
       string, and would hand JS a truthy "false" the moment it stopped doing so. #}
    has_saved_cards: {{ hasSavedCards|default(false) ? 'true' : 'false' }},
    locale: '{{ app.request.locale|split('_')|first }}',
    allowed_brands: {{ constant('PayPlug\\SyliusPayPlugPlugin\\PaymentProcessing\\HostedFieldsCaptureData::ALLOWED_BRANDS')|json_encode|raw }},
    card_holder_length: {
      min: {{ cardHolderMinLength }},
      max: {{ cardHolderMaxLength }},
    },
    error: {
      tokenization_failed: '{{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.error.tokenization_failed'|trans|e('js') }}',
      unsupported_brand: '{{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.error.unsupported_brand'|trans|e('js') }}',
      holder_required: '{{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.error.card_holder_required'|trans|e('js') }}',
      holder_length: '{{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.error.card_holder_length'|trans({'%min%': cardHolderMinLength, '%max%': cardHolderMaxLength})|e('js') }}',
    },
  }
  /* ]] */
</script>
<div
    class="payplugHostedFields"
    {{ stimulus_target('@payplug/sylius-payplug-plugin/hosted-fields', 'container') }}
    {# Must start "false" when a saved card is pre-selected: checkout-select-payment_controller
       reads this on connect() and disables the checkout's own next-step button whenever a
       payment method claims to submit inline — which Hosted Fields only does once the customer
       has actually picked "pay with another card". handleShow()/handleHide() keep it in sync
       from then on. #}
    data-payment-inline-submit="{{ hasSavedCards|default(false) is not same as true ? 'true' : 'false' }}"
>
    <div class="sylius-shop-loader d-none">
        <img src="{{ asset('build/shop/images/loader.gif', 'shop') }}" alt="{{ 'sylius.ui.loading'|trans }}" loading="lazy"/>
    </div>
    <div class="payplugHostedFields__field payplugHostedFields__field--holder">
        <div class="payplugHostedFields__container payplugHostedFields__container--holder" id="holder-container">
            {# No name: the value is copied into hostedfields_card_holder_name on submit, and a named
               input would trigger the checkout LiveComponent. #}
            <input
                type="text"
                id="hostedfields_card_holder"
                class="payplugHostedFields__holderInput"
                autocomplete="cc-name"
                placeholder="{{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.card_holder.placeholder'|trans }}"
                aria-label="{{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.card_holder.label'|trans }}"
                aria-describedby="hostedfields_card_holder_error"
                aria-invalid="false"
                {{ stimulus_target('@payplug/sylius-payplug-plugin/hosted-fields', 'holder') }}
            />
        </div>
        <div class="payplugHostedFields__fieldError" id="hostedfields_card_holder_error" data-field="holder" aria-live="polite"></div>
    </div>
    <div class="payplugHostedFields__field payplugHostedFields__field--card">
        <div class="payplugHostedFields__container payplugHostedFields__container--card" id="card-container"></div>
        <div class="payplugHostedFields__brand" id="brand-container"></div>
        <div class="payplugHostedFields__fieldError" data-field="card" aria-live="polite"></div>
    </div>
    <div class="payplugHostedFields__field payplugHostedFields__field--expiry">
        <div class="payplugHostedFields__container payplugHostedFields__container--expiry" id="expiry-container"></div>
        <div class="payplugHostedFields__fieldError" data-field="expiry" aria-live="polite"></div>
    </div>
    <div class="payplugHostedFields__field payplugHostedFields__field--cvv">
        <div class="payplugHostedFields__container payplugHostedFields__container--cvv" id="cvv-container"></div>
        <div class="payplugHostedFields__fieldError" data-field="cryptogram" aria-live="polite"></div>
    </div>
    <div class="payplugHostedFields__error payplugHostedFields__error--hide" {{ stimulus_target('@payplug/sylius-payplug-plugin/hosted-fields', 'error') }}></div>
    {% if is_save_card_enabled(paymentMethod) %}
        <div class="payplugHostedFields__container payplugHostedFields__container--saveCard">
            <input type="checkbox" id="hostedfields_savecard" name="" />{# No name to not trigger LiveComponent #}
            <label for="hostedfields_savecard">
                <span></span>
                {{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.save_card.label'|trans }}
            </label>
        </div>
    {% endif %}
    <div class="payplugHostedFields__container">
        <button {{ stimulus_target('@payplug/sylius-payplug-plugin/hosted-fields', 'submitButton') }} class="btn btn-primary" type="button">
            {{ 'payplug_sylius_payplug_plugin.ui.hosted_fields.place_order.label'|trans }}
        </button>
    </div>
</div>

<input type="hidden" name="hostedfields_token" id="hostedfields_token" />
<input type="hidden" name="hostedfields_selected_brand" id="hostedfields_selected_brand" />
<input type="hidden" name="hostedfields_save_card" id="hostedfields_save_card" />
<input type="hidden" name="hostedfields_last4" id="hostedfields_last4" />
<input type="hidden" name="hostedfields_exp_month" id="hostedfields_exp_month" />
<input type="hidden" name="hostedfields_exp_year" id="hostedfields_exp_year" />
<input type="hidden" name="hostedfields_country" id="hostedfields_country" />
<input type="hidden" name="hostedfields_card_holder_name" id="hostedfields_card_holder_name" />
